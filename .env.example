# Server & Hosting Configuration
PORT=5173
BASE_PATH=/

# ==========================================
# GOOGLE SHEETS INTEGRATION CONFIGURATION
# (Choose Option A OR Option B)
# ==========================================

# OPTION A: Google Apps Script Webhook (Easiest - 2 minutes setup)
# Follow the instructions in artifacts/rd-trauma-healing/google-sheets-script.js
# GOOGLE_SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/AKfycb.../exec"

# OPTION B: Google Cloud Service Account
# GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_SHEETS_SPREADSHEET_ID="your-google-sheet-id"

# ==========================================
# APPOINTMENT EMAIL NOTIFICATIONS
# ==========================================
# Where to receive appointment notifications (defaults to Rebecca's practice email):
# NOTIFICATION_EMAIL="wellbeingsessions@traumahealingwithrebeccadakin.co.uk"
#
# Choose ANY of the following email providers (Optional):
#
# Option 1: Resend (https://resend.com)
# RESEND_API_KEY="re_..."
#
# Option 2: SendGrid (https://sendgrid.com)
# SENDGRID_API_KEY="SG...."
#
# Option 3: Gmail App Password / Custom SMTP
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-16-char-google-app-password" # or GMAIL_APP_PASSWORD="your-16-char-google-app-password"
#
# Note: If you use OPTION A (Google Apps Script Webhook), email notifications
# are automatically sent directly from Google Apps Script via MailApp with 0 setup!
